# Copy to: /etc/nginx/sites-available/ghumone-api
# Then: sudo ln -s /etc/nginx/sites-available/ghumone-api /etc/nginx/sites-enabled/
#       sudo nginx -t && sudo systemctl reload nginx
#       sudo certbot --nginx -d api.ghumone.com

server {
    listen 80;
    server_name api.ghumone.com;

    client_max_body_size 20M;

    location / {
        proxy_pass http://127.0.0.1:3004;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    location /uploads/ {
        alias /var/www/ghumone-api/uploads/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
